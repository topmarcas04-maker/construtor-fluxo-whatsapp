# Database
DATABASE_URL=postgresql://user:password@localhost:5432/construtor_fluxo

# WhatsApp
WHATSAPP_PHONE_NUMBER=5511999999999

# Flow Engine
FLOW_ENGINE_PORT=3001
# Token opcional para proteger a página de QR Code e a API interna do motor
QR_ACCESS_TOKEN=

# App Web (SDR) — como chegar no motor de fluxo a partir do Next.js.
# No Railway, use a URL interna do serviço do motor, ex.:
# http://construtor-fluxo-whatsapp-motor.railway.internal:3001
FLOW_ENGINE_URL=http://localhost:3001
FLOW_ENGINE_TOKEN=

# Node
NODE_ENV=development

# --- IA de atendimento (configure no serviço do MOTOR no Railway) ---
# Chave da API da Anthropic (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Quanto a IA espera o cliente terminar de digitar, em milissegundos (padrão 6000)
AI_DEBOUNCE_MS=6000

# --- Login do painel (serviço do SITE) ---
# Texto aleatório longo para assinar a sessão. Vazio = usa um derivado do DATABASE_URL.
AUTH_SECRET=
